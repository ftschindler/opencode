            "fallback_models": [
                "ovhcloud/gpt-oss-120b"
            ]
        },
        "explore": {
            "model": "ovhcloud/qwen3.5-9b",
            "fallback_models": [
                "ovhcloud/gpt-oss-20b"
            ]
        },
        "librarian": {
            "model": "ovhcloud/qwen3.5-9b",
            "fallback_models": [
                "ovhcloud/gpt-oss-20b"
            ]
        },
        "multimodal-looker": {
            "model": "ovhcloud/qwen3.6-27b",
            "fallback_models": [
                "ovhcloud/mistral-small-3.2-24b-instruct-2506"
