# Any credential file in a profile. The glob covers .env and variants such
# as .env.PAT or .env.old, which a narrower 'profiles/*/.env' would miss.
profiles/*/.env
profiles/*/.env.*
!profiles/*/.env.sample
plugins/git-ai.ts
.omo/
tui.json
profiles/*/package.json
# Machine-local runtime state that opencode and the plugin write into whatever
# profile is active: a declined LSP install, the plugin's nudge frequency. Both
# describe this box rather than the configuration, and both regenerate.
profiles/*/lsp-install-decisions.json
profiles/*/oh-my-openagent/
